#compdef dnglab

autoload -U is-at-least

_dnglab() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-d+[Log level]:level:(error warn info debug trace)' \
'--loglevel=[Log level]:level:(error warn info debug trace)' \
'--profile-path=[Directory with profile TOML files]:dir:_files' \
'--config=[dnglab configuration file]:file:_files' \
'-v[Print status for every file]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_dnglab_commands" \
"*::: :->dnglab" \
&& ret=0
    case $state in
    (dnglab)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:dnglab-command-$line[1]:"
        case $line[1] in
            (convert)
_arguments "${_arguments_options[@]}" : \
'-p+[Convert profile name]:name:_default' \
'--profile=[Convert profile name]:name:_default' \
'-c+[Compression for raw image]:compression:(lossless lossy jxl deflate uncompressed)' \
'--compression=[Compression for raw image]:compression:(lossless lossy jxl deflate uncompressed)' \
'--ljpeg92-predictor=[LJPEG-92 predictor]:predictor:_default' \
'--lossy-jpeg-quality=[JPEG quality for lossy compression (1-100)]:quality:_default' \
'--jxl-distance=[JPEG XL distance (0-25), 0 is lossless]:distance:_default' \
'--jxl-effort=[JPEG XL encoder effort (1-9)]:effort:_default' \
'--jxl-decode-speed=[JPEG XL decoding speed for lossy compression (1-4)]:speed:_default' \
'--dng-preview=[DNG include preview image]:preview:(true false)' \
'--dng-thumbnail=[DNG include thumbnail image]:thumbnail:(true false)' \
'--dng-force-preview=[Generate DNG preview image from raw data]:force_preview:(true false)' \
'--dng-force-thumbnail=[Generate DNG thumbnail image from raw data]:force_thumbnail:(true false)' \
'--max-dng-backward-version=[Maximum DNG backward version]:version:(1.0 1.1 1.2 1.3 1.4 1.5 1.6 1.7 1.7.1)' \
'--embed-raw=[Embed the raw file into DNG]:embedded:(true false)' \
'--apply-dng-opcodes=[Apply DNG opcode lists to the image data instead of writing them to the DNG]:mode:(auto list1 list2 list3)' \
'*--remove-dng-opcodes=[Remove DNG opcodes, as comma separated \[<list>\:\]<opcode> (e.g. WarpRectilinear,2\:GainMap)]:opcodes:_default' \
'--artist=[Set the artist tag]:artist:_default' \
'--copyright=[Set the copyright tag]:copyright:_default' \
'--keep-mtime=[Keep mtime, read from EXIF with fallback to original file mtime]:keepmtime:(true false)' \
'--image-index=[Select a specific image index (or '\''all'\'') if file is a image container]:index:_default' \
'--crop=[DNG default crop]:crop:(best activearea none)' \
'--colorspace=[Colorspace of resulting DNG image]:COLORSPACE:(srgb adobergb prophoto)' \
'*--render-steps=[Render pipeline steps]:steps:(rescale demosaic fujirotate cropactivearea baselineexposure whitebalance autowhitebalance calibrate profilerender tonecurve cropdefault denoise defaultscale exposure autoexposure sharpen transferfunction)' \
'*--hide-steps=[Hide render pipeline steps]:steps:(rescale demosaic fujirotate cropactivearea baselineexposure whitebalance autowhitebalance calibrate profilerender tonecurve cropdefault denoise defaultscale exposure autoexposure sharpen transferfunction)' \
'--denoise=[Amount of denoising applied to rendered image (0.00..=4.00)]:strength:_default' \
'--sharpen=[Amount of sharpening applied to rendered image (0.00..=2.00)]:strength:_default' \
'--sharpness-radius=[Radius in px of sharpening mask]:radius:_default' \
'--saturation=[Change hue and saturation of the rendered image]:hue_saturation:_default' \
'--contrast=[Change the exposure (+EV) and contrast of the rendered image]:exposure_contrast:_default' \
'--highlight=[Recover highlights (0.00..=1.00)]:highlight:_default' \
'--blackpoint=[Adjust blackpoint (0.0..=1.0)]:blackpoint:_default' \
'--gradient=[Tint the gradient along a certain axis (x y)]:tint_gradient:_default' \
'--tint=[Set white balance via temperature/tint]:temperature_tint:_default' \
'--whitebalance-rgb=[Manual whitebalance RGB values]:rgb:_default' \
'--exposure=[Additional manual exposure adjustment in EV]:exposure:_default' \
'--chromatic-aberration=[Correct chromatic aberration (0.00..=1.00)]:correction:_default' \
'--vignetting=[Correct vignetting (0.00..=1.00)]:amount:_default' \
'--distorting=[Correct distortion (0.00..=1.00)]:amount:_default' \
'--camera-profile=[Set custom camera profile]:PROFILE:_default' \
'-t+[Linearization table]:path:_files' \
'--linearization=[Linearization table]:path:_files' \
'(--white-xy)--wb=[Whitebalance as-shot]:R,G,B:_default' \
'--white-xy=[Whitebalance as-shot encoded as xy chromaticity coordinates]:x,y:_default' \
'-d+[Log level]:level:(error warn info debug trace)' \
'--loglevel=[Log level]:level:(error warn info debug trace)' \
'--profile-path=[Directory with profile TOML files]:dir:_files' \
'--config=[dnglab configuration file]:file:_files' \
'-f[Override existing files]' \
'--override[Override existing files]' \
'-f[Override existing files]' \
'--override[Override existing files]' \
'-v[Print status for every file]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':INPUT -- Input file or directory:_files' \
':OUTPUT -- Output file or existing directory:_files' \
":: :_dnglab__subcmd__convert_commands" \
"*::: :->convert" \
&& ret=0

    case $state in
    (convert)
        words=($line[3] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:dnglab-convert-command-$line[3]:"
        case $line[3] in
            (raw)
_arguments "${_arguments_options[@]}" : \
'-d+[Log level]:level:(error warn info debug trace)' \
'--loglevel=[Log level]:level:(error warn info debug trace)' \
'--profile-path=[Directory with profile TOML files]:dir:_files' \
'--config=[dnglab configuration file]:file:_files' \
'-v[Print status for every file]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':INPUT -- Input file or directory:_files' \
':OUTPUT -- Output file or existing directory:_files' \
&& ret=0
;;
(r)
_arguments "${_arguments_options[@]}" : \
'-d+[Log level]:level:(error warn info debug trace)' \
'--loglevel=[Log level]:level:(error warn info debug trace)' \
'--profile-path=[Directory with profile TOML files]:dir:_files' \
'--config=[dnglab configuration file]:file:_files' \
'-v[Print status for every file]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':INPUT -- Input file or directory:_files' \
':OUTPUT -- Output file or existing directory:_files' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_dnglab__subcmd__convert__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:dnglab-convert-help-command-$line[1]:"
        case $line[1] in
            (raw)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(reembed)
_arguments "${_arguments_options[@]}" : \
'--dng=[Input DNG file]:DNG:_files' \
'--preview=[Edited preview JPEG]:JPEG:_files' \
'--output=[Output DNG (default\: overwrite input)]:OUTPUT:_files' \
'--embed-raw=[Embed original raw file]:embedded:(true false)' \
'--compression=[Compression method for raw image]:compression:(lossless lossy jxl deflate uncompressed)' \
'--crop=[Crop mode\: best, activearea, none]:crop:(best activearea none)' \
'--predictor=[LJPEG92 predictor (1-7)]:predictor:_default' \
'--preview-enabled=[Include preview in output DNG]:enabled:(true false)' \
'--thumbnail-enabled=[Include thumbnail in output DNG]:enabled:(true false)' \
'--artist=[Set artist tag]:artist:_default' \
'--seed=[Deterministic seed for output bytes]:seed:_default' \
'-d+[Log level]:level:(error warn info debug trace)' \
'--loglevel=[Log level]:level:(error warn info debug trace)' \
'--profile-path=[Directory with profile TOML files]:dir:_files' \
'--config=[dnglab configuration file]:file:_files' \
'--compress[Use lossless compression]' \
'-v[Print status for every file]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(cameras)
_arguments "${_arguments_options[@]}" : \
'-d+[Log level]:level:(error warn info debug trace)' \
'--loglevel=[Log level]:level:(error warn info debug trace)' \
'--profile-path=[Directory with profile TOML files]:dir:_files' \
'--config=[dnglab configuration file]:file:_files' \
'--md[Markdown format output]' \
'-v[Print status for every file]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(lenses)
_arguments "${_arguments_options[@]}" : \
'-d+[Log level]:level:(error warn info debug trace)' \
'--loglevel=[Log level]:level:(error warn info debug trace)' \
'--profile-path=[Directory with profile TOML files]:dir:_files' \
'--config=[dnglab configuration file]:file:_files' \
'--md[Markdown format output]' \
'-v[Print status for every file]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_dnglab__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:dnglab-help-command-$line[1]:"
        case $line[1] in
            (convert)
_arguments "${_arguments_options[@]}" : \
":: :_dnglab__subcmd__help__subcmd__convert_commands" \
"*::: :->convert" \
&& ret=0

    case $state in
    (convert)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:dnglab-help-convert-command-$line[1]:"
        case $line[1] in
            (raw)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(reembed)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(cameras)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(lenses)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_dnglab_commands] )) ||
_dnglab_commands() {
    local commands; commands=(
'convert:Convert raw image(s) into dng format' \
'reembed:Re-embed edited preview into an existing DNG' \
'cameras:List supported cameras' \
'lenses:List supported lenses' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'dnglab commands' commands "$@"
}
(( $+functions[_dnglab__subcmd__cameras_commands] )) ||
_dnglab__subcmd__cameras_commands() {
    local commands; commands=()
    _describe -t commands 'dnglab cameras commands' commands "$@"
}
(( $+functions[_dnglab__subcmd__convert_commands] )) ||
_dnglab__subcmd__convert_commands() {
    local commands; commands=(
'raw:Convert raw images to DNG (deprecated\: same as convert)' \
'r:Convert raw images to DNG (deprecated\: same as convert)' \
'help:Print this message or the help of the given subcommand(s)' \
